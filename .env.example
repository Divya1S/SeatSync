# SeatSync environment variables. Copy to `.env` (git-ignored) and adjust.
# Everything has a laptop-friendly default; only JWT_SECRET is unsafe to leave
# at its default anywhere other than localhost.

# --- security -----------------------------------------------------------------
# HS256 signing key shared by every service; 32+ bytes. Services WARN at startup
# while the built-in development value is in use.
JWT_SECRET=seatsync-dev-secret-change-me-0123456789abcdef
# Seeded admin account password.
ADMIN_PASSWORD=admin123!
# Comma-separated SPA origins the gateway allows (with credentials).
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Use the first X-Forwarded-For value as the rate-limit key. Only behind a
# trusted proxy that overwrites the header; otherwise clients can spoof it.
TRUST_XFF=false

# --- rate limits (per client IP, per gateway route) ----------------------------
RATE_LIMIT_REPLENISH=20
RATE_LIMIT_BURST=40
# The public chat endpoint costs model tokens per call: keep this small.
CHAT_RATE_LIMIT_REPLENISH=2
CHAT_RATE_LIMIT_BURST=5

# --- booking ------------------------------------------------------------------
# ISO-8601 durations. Redis PX and the DB expiry both derive from these.
HOLD_TTL=PT5M
OFFER_TTL=PT10M
# Active holds one account may have on one event.
MAX_ACTIVE_HOLDS_PER_USER=10

# --- catalog ------------------------------------------------------------------
# Set false to bypass the Redis cache-aside layer (load-test baseline).
CATALOG_CACHE_ENABLED=true

# --- AI concierge -------------------------------------------------------------
# Leave at the placeholder to run the concierge in honest offline mode.
OPENAI_API_KEY=sk-dummy-offline
OPENAI_CHAT_MODEL=gpt-4o-mini
# Bounds on the in-memory conversation store (per instance).
CHAT_MEMORY_IDLE_TTL=PT30M
CHAT_MEMORY_MAX_CONVERSATIONS=10000

# --- infrastructure (compose sets these; shown for completeness) ---------------
# SPRING_DATA_REDIS_HOST=redis
# SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# MANAGEMENT_ZIPKIN_TRACING_ENDPOINT=http://zipkin:9411/api/v2/spans
# LOG_FORMAT=ecs
